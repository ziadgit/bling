# Copy to .env (gitignored) and fill in the keys.

# Live traffic and transit conditions: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Drive-vs-transit decision with Jev through TypeSafe: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Your own Deepgram key: Vapi uses it for call transcription + voice; the CLI uses it for --audio/--say: https://console.deepgram.com
DEEPGRAM_API_KEY=
# Vapi private API key: https://dashboard.vapi.ai
VAPI_API_KEY=
# Shared secret Bling expects in the x-bling-secret header; any long random string
VAPI_SERVER_SECRET=
# Public https URL that reaches `bling serve` (e.g. an ngrok/cloudflared tunnel), no trailing slash
PUBLIC_BASE_URL=
# Printed by `bling vapi-sync` the first time
VAPI_ASSISTANT_ID=

# Optional, shown with defaults:
# BLING_REGION=San Francisco Bay Area, CA
# JEV_MODEL=jev-1.13.0
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# VAPI_LLM_PROVIDER=openai
# VAPI_LLM_MODEL=gpt-4.1
# VAPI_VOICE_ID=asteria
