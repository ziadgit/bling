# Copy to .env (gitignored) and fill in the keys.

# Live traffic and transit conditions: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Drive-vs-transit decision with Jev through TypeSafe: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Voice assistant: https://dashboard.vapi.ai (private API key)
VAPI_API_KEY=
# Shared secret Vapi sends to the webhook; pick any long random string
VAPI_SERVER_SECRET=

# Optional, shown with defaults:
# JEV_MODEL=jev-1.13.0
# BLING_DATA_DIR=data
# PUBLIC_BASE_URL=            # https URL Vapi / SMS provider can reach (e.g. a tunnel)
